APP_NAME="مركز الغفران لتحفيظ القرآن الكريم"
APP_LOGO="images/gofran-logo.jpeg"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
TWO_FACTOR_AUTH_ENABLED=false
APP_TIMEZONE=Asia/Hebron

APP_LOCALE=ar
APP_FALLBACK_LOCALE=ar
APP_FAKER_LOCALE=ar_SA

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=alquran_center
DB_USERNAME=root
DB_PASSWORD=
DB_QUERY_BUDGET_MS=750

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=private
QUEUE_CONNECTION=database
DB_QUEUE_RETRY_AFTER=960

SANCTUM_EXPIRATION=43200
SANCTUM_TOKEN_PREFIX=alquran_
MOBILE_APP_RELEASE_ENABLED=false
MOBILE_APP_VERSION=1.3.1
MOBILE_APP_VERSION_CODE=5
MOBILE_APP_MINIMUM_VERSION_CODE=1
MOBILE_ANDROID_APK_PATH=releases/gofran-mobile-1.3.1-5.apk
# Leave empty in production to derive this from APP_URL. Set only for local
# dashboard testing when installing an APK that targets the production API.
MOBILE_API_BASE_URL=
MOBILE_APP_RELEASE_NOTES=
MOBILE_APP_PUBLISHED_AT=
PUBLIC_WHATSAPP_NUMBER=972567973076
PUBLIC_WHATSAPP_DISPLAY_NUMBER="+972 56 797 3076"
PUBLIC_WHATSAPP_MESSAGE="السلام عليكم، أود الاستفسار عن مركز الغفران لتحفيظ القرآن الكريم."
PUBLIC_CENTER_LATITUDE=31.382208090207207
PUBLIC_CENTER_LONGITUDE=34.331760937834474

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Used only by `php artisan db:seed` to create the first administrator.
INITIAL_ADMIN_NAME=
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=

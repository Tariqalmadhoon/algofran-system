APP_NAME="نظام مركز القرآن الكريم"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://quran-center.example.com
CORS_ALLOWED_ORIGINS=https://quran-center.example.com
APP_TIMEZONE=Asia/Hebron

APP_LOCALE=ar
APP_FALLBACK_LOCALE=ar
APP_FAKER_LOCALE=ar_SA

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=alquran_center
DB_USERNAME=alquran_app
DB_PASSWORD=
DB_QUERY_BUDGET_MS=750

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=quran-center.example.com
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
AUTH_PASSWORD_TIMEOUT=900

CACHE_STORE=database
QUEUE_CONNECTION=database
DB_QUEUE_RETRY_AFTER=960

FILESYSTEM_DISK=private
BROADCAST_CONNECTION=reverb

REVERB_APP_ID=alquran-production
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=realtime.quran-center.example.com
REVERB_PORT=443
REVERB_SCHEME=https
REVERB_SERVER_HOST=127.0.0.1
REVERB_SERVER_PORT=8080
REVERB_ALLOWED_ORIGINS=quran-center.example.com

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

SANCTUM_EXPIRATION=43200
SANCTUM_TOKEN_PREFIX=alquran_

MAIL_MAILER=smtp
MAIL_SCHEME=tls
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=no-reply@example.com
MAIL_FROM_NAME="${APP_NAME}"

INITIAL_ADMIN_NAME=
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=

VITE_APP_NAME="${APP_NAME}"

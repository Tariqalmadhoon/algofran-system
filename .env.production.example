APP_NAME="مركز الغفران لتحفيظ القرآن الكريم"
APP_LOGO="images/gofran-logo.jpeg"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://algofran-center.tech
CORS_ALLOWED_ORIGINS=https://algofran-center.tech
TWO_FACTOR_AUTH_ENABLED=false
APP_TIMEZONE=Asia/Hebron

APP_LOCALE=ar
APP_FALLBACK_LOCALE=ar
APP_FAKER_LOCALE=ar_SA

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=alquran_center
DB_USERNAME=alquran_app
DB_PASSWORD=
DB_QUERY_BUDGET_MS=750

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
AUTH_PASSWORD_TIMEOUT=900

CACHE_STORE=database
QUEUE_CONNECTION=database
DB_QUEUE_RETRY_AFTER=960

FILESYSTEM_DISK=private
# Shared hosting uses polling. Set reverb only after configuring a VPS worker.
BROADCAST_CONNECTION=null

REVERB_APP_ID=alquran-production
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=realtime.algofran-center.tech
REVERB_PORT=443
REVERB_SCHEME=https
REVERB_SERVER_HOST=127.0.0.1
REVERB_SERVER_PORT=8080
REVERB_ALLOWED_ORIGINS=algofran-center.tech

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

SANCTUM_EXPIRATION=43200
SANCTUM_TOKEN_PREFIX=alquran_

MOBILE_APP_RELEASE_ENABLED=false
MOBILE_APP_VERSION=1.3.1
MOBILE_APP_VERSION_CODE=5
MOBILE_APP_MINIMUM_VERSION_CODE=1
MOBILE_ANDROID_APK_PATH=releases/gofran-mobile-1.3.1-5.apk
MOBILE_API_BASE_URL=
MOBILE_APP_RELEASE_NOTES=
MOBILE_APP_PUBLISHED_AT=
PUBLIC_WHATSAPP_NUMBER=972567973076
PUBLIC_WHATSAPP_DISPLAY_NUMBER="+972 56 797 3076"
PUBLIC_WHATSAPP_MESSAGE="السلام عليكم، أود الاستفسار عن مركز الغفران لتحفيظ القرآن الكريم."
PUBLIC_CENTER_LATITUDE=31.382208090207207
PUBLIC_CENTER_LONGITUDE=34.331760937834474
CONTACT_PHONE_DEFAULT_COUNTRY_CALLING_CODE=972

MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=no-reply@algofran-center.tech
MAIL_FROM_NAME="${APP_NAME}"

INITIAL_ADMIN_NAME=
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=

VITE_APP_NAME="${APP_NAME}"
